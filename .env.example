# API Anahtarları (Bu dosyayı .env olarak kopyalayın; gerçek .env dosyasını Git'e eklemeyin)
GEMINI_API_KEY=

# İsteğe bağlı alternatif LLM veya rota servisi anahtarları
GROQ_API_KEY=
ORS_API_KEY=

# Yayın ve kota koruma ayarları
USE_MOCK_UI=false
DAILY_LIMIT_PER_SESSION=15
DEFAULT_CITY_NAME=Kocaeli

# İsteğe bağlı Supabase (Ücretsiz Plan Auth + Kayıtlı Geziler veritabanı; boş bırakılırsa yerel SQLite kullanılır)
SUPABASE_URL=
SUPABASE_ANON_KEY=
